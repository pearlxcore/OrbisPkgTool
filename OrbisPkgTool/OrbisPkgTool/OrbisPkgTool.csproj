<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>OrbisPkgTool</AssemblyName>
    <RootNamespace>OrbisPkgTool</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="LibOrbisPkg.Core">
      <HintPath>C:\Users\User\source\repos\PS4PKGTool\Library.Core\LibOrbisPkg.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OrbisPkgTool.Tests" />
  </ItemGroup>

</Project>
